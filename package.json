{
    "workspaces": [
        "./shared",
        "./client",
        "./desktop"
    ],
    "scripts": {
        "build": "npm run build -w shared && npm run build -w client",
        "check": "npm run check -w client",
        "lint": "eslint .",
        "desktop:dev": "npm run build && npm run start -w desktop",
        "desktop:dist": "npm run build && npm run dist -w desktop"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin-ts": "^2.1.0",
        "eslint": "^8.57.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^7.12.0",
        "webpack-bundle-analyzer": "^4.10.2"
    },
    "name": "offlinechess",
    "private": true
}
