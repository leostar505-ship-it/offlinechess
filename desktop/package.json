{
    "name": "desktop",
    "productName": "OfflineChess",
    "version": "1.4.1",
    "description": "OfflineChess - WintrChess analysis as a local desktop app, no ads",
    "author": "leostar505 <leostar505-ship-it@users.noreply.github.com>",
    "license": "GPL-3.0-only",
    "private": true,
    "main": "main.js",
    "scripts": {
        "prepare-app": "node scripts/prepare.js",
        "start": "node scripts/prepare.js && electron .",
        "dist": "node scripts/dist.js",
        "dist:release": "node scripts/dist.js skeleton --plain",
        "dist:linux": "node scripts/dist.js skeleton --plain --linux",
        "dist:alt": "node scripts/dist.js full lite",
        "dist:alt-linux": "node scripts/dist.js full lite --linux"
    },
    "devDependencies": {
        "electron": "45.0.0",
        "electron-builder": "26.15.3",
        "stockfish": "19.0.1"
    },
    "build": {
        "appId": "com.offlinechess.app",
        "productName": "OfflineChess",
        "copyright": "GPL-3.0, based on WintrChess",
        "asar": true,
        "compression": "normal",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "main.js",
            "engine-download.js",
            "coach.js",
            "coach-worker.js",
            "setup/**/*",
            "package.json",
            "build/icon.png",
            "app/**/*",
            "!**/node_modules/@node-llama-cpp/*-cuda*/**",
            "!**/node_modules/@node-llama-cpp/*-vulkan*/**",
            "!**/node_modules/@node-llama-cpp/*-metal*/**",
            "!**/node_modules/@node-llama-cpp/mac-*/**",
            "!**/node_modules/@node-llama-cpp/linux-arm*/**",
            "!**/node_modules/@node-llama-cpp/win-arm64*/**",
            "!**/node_modules/node-llama-cpp/llama/localBuilds/**",
            "!**/node_modules/node-llama-cpp/llama/llama.cpp/**",
            "!**/node_modules/node-llama-cpp/llama/gpuInfo/**"
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "shortcutName": "OfflineChess",
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico",
            "installerHeaderIcon": "build/icon.ico",
            "artifactName": "OfflineChess-Setup-${version}.exe"
        },
        "portable": {
            "artifactName": "OfflineChess-Portable-${version}.exe"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "build/icon.png",
            "category": "Game",
            "synopsis": "Ad-free local chess game analysis",
            "maintainer": "leostar505 <leostar505-ship-it@users.noreply.github.com>",
            "artifactName": "OfflineChess-${version}.${ext}"
        },
        "asarUnpack": [
            "coach-worker.js",
            "node_modules/**/*"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/leostar505-ship-it/offlinechess.git"
    },
    "dependencies": {
        "node-llama-cpp": "3.22.2"
    }
}
